# Copy to the deploy target / CI secrets and adjust. Values below are the
# local-dev defaults, so a fresh clone needs no .env to run everything.

# --- Web (apps/web) -----------------------------------------------------------
# Public URL of the realtime service the BROWSER connects to. Baked at build
# time in production (Docker ARG NEXT_PUBLIC_REALTIME_URL); dev default below.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# Realtime service reachable from the Next server (server-side vitals forward
# in /api/vitals). Defaults to NEXT_PUBLIC_REALTIME_URL when unset.
# REALTIME_URL=http://localhost:3001

# Optional AI assistant. Server-only.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Realtime (apps/realtime) -------------------------------------------------
# SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>
# CORS_ORIGIN=http://localhost:3000
# LOG_LEVEL=info

# --- Observability: OpenTelemetry (apps/realtime) -----------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=caderno-realtime

# --- Terraform deploy (terraform/deploy.sh) -----------------------------------
# PROJECT_ID=<gcp-project>
# REGION=us-central1
# REGISTRY=us-central1-docker.pkg.dev/<gcp-project>/caderno
# GCS_BUCKET=<terraform-state-bucket>
# CORS_ORIGIN=https://caderno-web-<hash>-<region>.a.run.app
